    "server/requirements.txt",
    "server/pyproject.toml",
    "server/README.md",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@brain/core": "workspace:*",
    "@brain/sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
