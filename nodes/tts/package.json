  },
  "dependencies": {
    "@brain/core": "workspace:*",
    "@brain/sdk": "workspace:*",
    "kokoro-js": "^1.2.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  }
