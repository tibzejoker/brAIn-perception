{
  "name": "@brain/node-tts",
  "version": "0.1.0",
  "description": "brAIn node — cross-platform text-to-speech using built-in OS engines (say / espeak-ng / System.Speech). Listens on tts.speak.",
  "license": "MIT",
  "main": "dist/handler.js",
  "types": "dist/handler.d.ts",
  "files": [
    "dist",
